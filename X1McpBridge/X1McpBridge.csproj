  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!--
    Stamp the assembly version from version.props. This project predates SDK-style
    GenerateAssemblyInfo, so the attributes are generated into obj\ and compiled in rather than
    living in AssemblyInfo.cs - that keeps version.props the only file bump.bat has to write,
    and keeps this exe's version identical to the daemon's by construction.
  -->
  <Target Name="GenerateVersionInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <VersionInfoFile>$(IntermediateOutputPath)VersionInfo.g.cs</VersionInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <!-- %3B is an escaped ';' - MSBuild splits item values on a literal one, which would emit
           the tail of this comment as a second, non-C# line. -->
      <VersionInfoLines Include="// &lt;auto-generated /&gt; Generated from X1Mcp\version.props - do not edit%3B run bump.bat." />
      <VersionInfoLines Include="[assembly: System.Reflection.AssemblyVersion(&quot;$(X1McpVersion)&quot;)]" />
      <VersionInfoLines Include="[assembly: System.Reflection.AssemblyFileVersion(&quot;$(X1McpVersion)&quot;)]" />
      <VersionInfoLines Include="[assembly: System.Reflection.AssemblyInformationalVersion(&quot;$(X1McpVersion)&quot;)]" />
    </ItemGroup>
    <WriteLinesToFile File="$(VersionInfoFile)" Lines="@(VersionInfoLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(VersionInfoFile)" />
      <FileWrites Include="$(VersionInfoFile)" />
    </ItemGroup>
  </Target>
</Project>
