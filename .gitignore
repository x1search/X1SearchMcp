
**/bin/**
**/obj/**

# Downloaded build tool (re-fetched on demand by build/test scripts)
nuget.exe

# Test + trace output
TestResult*.xml
TestResults*.xml
*.log

# Built installer payload (regenerated by build-installer.bat; not versioned)
installer/X1McpBridge.exe

# The rest of installer/ is build output too, and build-installer.bat REWRITES these on every run
# (install.ps1 at the "Copy the installer script" step, x1mcp.config.json and skill/ just after).
# They were tracked by accident; leaving them tracked means editing the real source and not
# rebuilding silently leaves a diverged copy staged, so the INSTALLED behaviour differs from the
# reviewed source. Edit X1Mcp/install.ps1, X1Mcp/x1mcp.config.json and X1Mcp/skill/ instead.
installer/install.ps1
installer/x1mcp.config.json
installer/skill/

# Self-contained X1McpGraphQL daemon (Full flavor only): publish staging dir + its files copied
# into installer/. Regenerated by build-installer.bat --full; not versioned - the daemon's own
# source lives in the sibling ../X1McpGraphQL directory, not here.
X1McpGraphQL/
installer/X1McpGraphQL.exe
installer/appsettings.json
# Written at runtime by the daemon into its own working directory, so it lands here if anyone runs
# the daemon straight out of installer\.
installer/schema.graphql

# Restored NuGet packages (reproducible via `nuget restore`)
packages/

# Packaged skill artifact (regenerated from skill/x1/ via the skill packager)
*.skill

# Cowork plugin: staged payload + packaged artifact (built by build-plugin.ps1)
cowork-plugin/connector/
cowork-plugin/skills/
*.plugin

# GitHub Copilot plugin: staged payload + the unzipped directory build-copilot-plugin.ps1 emits
# into installer/. The directory is an output in its own right, not just an unzipping convenience:
# `copilot plugin install` takes no local path, so a local build is consumed via --plugin-dir,
# which needs the tree on disk. (The .plugin zip itself is already covered by *.plugin above.)
copilot-plugin/connector/
copilot-plugin/skills/
installer/copilot-plugin/

# MCPB desktop extension: staged payload + packaged artifact (built by build-mcpb.ps1)
mcpb-package/server/
*.mcpb

# Personal IDE settings (Rider/ReSharper, Visual Studio) - never shared
*.DotSettings.user
.vs/
.idea/

