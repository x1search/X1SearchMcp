{
  "manifest_version": "0.3",
  "name": "x1-search",
  "version": "1.0.37",
  "description": "Search and preview your own content from Claude — local files, Outlook/Exchange/Gmail email and attachments, cloud files (OneDrive, GDrive, Dropbox, SharePoint), and chat (Teams, Slack) — powered by your local X1 Search index.",
  "author": {
    "name": "X1 Discovery, Inc.",
    "url": "https://github.com/x1search"
  },
  "display_name": "X1 Search",
  "homepage": "https://www.x1.com",
  "documentation": "https://github.com/x1search/X1SearchMcp/blob/main/docs/UserManual.md",
  "support": "https://github.com/x1search/X1SearchMcp/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/x1search/X1SearchMcp.git"
  },
  "keywords": ["x1", "search", "files", "email", "attachments", "preview", "mcp"],
  "license": "MIT",
  "server": {
    "type": "binary",
    "entry_point": "server/X1McpBridge.exe",
    "mcp_config": {
      "command": "${__dirname}/server/X1McpBridge.exe",
      "args": ["--proxy"]
    }
  },
  "compatibility": {
    "platforms": ["win32"],
    "claude_desktop": ">=0.10.0"
  },
  "privacy_policies": ["https://www.x1.com/privacy-and-terms/"]
}
